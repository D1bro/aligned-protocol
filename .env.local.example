# Copy this file to .env.local and fill in real values.
# Find these in your Supabase project: Settings -> API.

NEXT_PUBLIC_SUPABASE_URL=https://yeedrmvikdjcrjvfyceo.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-only. Never expose this to the browser, never prefix it with NEXT_PUBLIC_.
# Used only for the one thing the anon key can't safely do: creating a client's
# login without hijacking the coach's own browser session. Find it under
# Settings -> API -> service_role (click "Reveal").
SUPABASE_SERVICE_ROLE_KEY=
